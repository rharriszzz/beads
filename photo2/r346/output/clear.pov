// Shared rounded glass geometry for every pigment; only optics change.
#macro Glass(C,F)
 material { texture { pigment { color srgbft <C.x,C.y,C.z,F,0> }
 finish { ambient 0.075 diffuse 0.7 specular 0.6 roughness 0.013
 reflection { 0.015,0.1 fresnel on } conserve_energy } }
 interior { ior 1.5 fade_distance 2.5 fade_power 1 fade_color rgb C } }
#end
